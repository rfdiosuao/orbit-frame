# 本机中转端口（对外给客户端用）
PORT=8787

# 本地访问密钥（客户端 Authorization: Bearer <此值>）
# 不要用豆包 sessionid；session 由登录流程自动写入 data/
LOCAL_API_KEY=local-dev-key-change-me

# 本机 Node 启动的 doubao-free-api 地址（默认 8000）
UPSTREAM_URL=http://127.0.0.1:8000

# Playwright 用户数据目录（保留登录态，减少重复扫码）
BROWSER_PROFILE_DIR=data/browser-profile

# 抗风控：连接本机 Chrome/Edge 远程调试（调试窗口登录后生效）
# DOUBAO_USE_CDP=1
# DOUBAO_CDP_URL=http://127.0.0.1:9222

# 日志目录（按天切分：relay-YYYY-MM-DD.log）
LOG_DIR=data/logs

# 图生视频/首尾帧图片目录（图片路径必须位于此目录内）
# ORBIT_FRAME_MEDIA_DIR=data/media

# MCP 视频导出目录（建议使用绝对路径，默认项目 data/exports）
# ORBIT_FRAME_OUTPUT_DIR=/absolute/path/orbit-frame/data/exports
