# 本机网关端口，只监听 127.0.0.1
PORT=8787

# 留空即可：首次启动自动生成本机访问密钥并保存到 .env
# 网页、CLI、MCP 自动读取。连接设置里可以复制给其他程序。
# 不是豆包密钥，也不要填豆包 Cookie 或生图服务密钥。
LOCAL_API_KEY=

# 本机 Node 启动的 doubao-free-api 地址（默认 8000）
UPSTREAM_URL=http://127.0.0.1:8000
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# 桌面视频桥接：Doubao.app，独立于下方的网页登录调试端口
DOUBAO_CDP_ENDPOINT=http://127.0.0.1:9225
# 非标准安装位置可取消注释并修改；不支持把独立 DoubaoWork.app 当作 Doubao.app。
# DOUBAO_APP=/Applications/Doubao.app

# Playwright 用户数据目录（保留登录态，减少重复扫码）
BROWSER_PROFILE_DIR=data/browser-profile

# 抗风控：连接本机 Chrome/Edge 远程调试（调试窗口登录后生效）
# DOUBAO_USE_CDP=1
# DOUBAO_CDP_URL=http://127.0.0.1:9222

# 日志目录（按天切分：relay-YYYY-MM-DD.log）
LOG_DIR=data/logs

# 外接生图通过本机 /image-provider.html 保存，无需在这里填写密钥。
# OPENAI_* 配置文件可用 skills/orbit-frame/scripts/orbit.mjs configure-images 导入。
